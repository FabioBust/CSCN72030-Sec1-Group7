<Window x:Class="AquaGuard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaGuard" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28" Width="320">
        <TextBlock Text="Choose access mode" FontSize="24" Margin="0,0,0,16"/>
        <Button Content="_Staff" Click="SelectStaff" Padding="8" Margin="0,0,0,8"/>
        <Button Content="_Visitor" Click="SelectVisitor" Padding="8"/>
        <StackPanel x:Name="StaffCodePanel" Visibility="Collapsed" Margin="0,16,0,0">
            <Label Content="Staff _code" Target="{Binding ElementName=StaffCode}"/>
            <PasswordBox x:Name="StaffCode" Padding="6"/>
            <Button Content="_Sign in" Click="SubmitStaffCode" IsDefault="True" Padding="8" Margin="0,8,0,0"/>
            <TextBlock x:Name="LoginError" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </StackPanel>
</Window>
