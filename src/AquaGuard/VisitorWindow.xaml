<Window x:Class="AquaGuard.VisitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaGuard | Visitor Mode" Height="400" Width="640"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28">
        <TextBlock Text="Visitor Mode" FontSize="24"/>
        <Button Content="_Back to mode selection" Click="BackToLogin"
                HorizontalAlignment="Left" Padding="8" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
