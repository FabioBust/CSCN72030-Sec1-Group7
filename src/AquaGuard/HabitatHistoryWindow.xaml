<Window x:Class="AquaGuard.HabitatHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="460" MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="22" Margin="0,0,0,12"/>
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="0,0,0,8"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="Newer" Content="_Newer records" Click="ShowNewer" Padding="8,4"/>
            <Button x:Name="Older" Content="_Older records" Click="ShowOlder" Margin="8,0" Padding="8,4"/>
            <Button Content="_Close" IsCancel="True" Padding="8,4"/>
        </StackPanel>
        <ListView x:Name="Records" AutomationProperties.Name="Habitat history records">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time (UTC)" DisplayMemberBinding="{Binding TimestampUtc}" Width="250"/>
                    <GridViewColumn Header="Event" DisplayMemberBinding="{Binding Kind}" Width="125"/>
                    <GridViewColumn Header="Device" DisplayMemberBinding="{Binding DeviceId}" Width="145"/>
                    <GridViewColumn Header="Setting" DisplayMemberBinding="{Binding Setting}" Width="135"/>
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="90"/>
                    <GridViewColumn Header="Unit" DisplayMemberBinding="{Binding Unit}" Width="65"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
