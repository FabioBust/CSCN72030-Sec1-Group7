<Window x:Class="AquaGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaGuard | Staff Dashboard" Height="520" Width="900">
    <DockPanel Margin="28">
        <TextBlock DockPanel.Dock="Top" Text="Staff Dashboard" FontSize="24" Margin="0,0,0,16"/>
        <TextBlock x:Name="SensorStatus" DockPanel.Dock="Top" Margin="0,0,0,8"/>
        <TextBlock x:Name="SensorLoggingStatus" DockPanel.Dock="Top" TextWrapping="Wrap"/>
        <TextBlock x:Name="AlarmStatus" DockPanel.Dock="Top" TextWrapping="Wrap"/>
        <StackPanel DockPanel.Dock="Top">
            <Label Content="_Habitat" Target="{Binding ElementName=HabitatSelection}"/>
            <ComboBox x:Name="HabitatSelection" DisplayMemberPath="Name" SelectionChanged="SelectHabitat"/>
            <WrapPanel Margin="0,8">
                <Label Content="_Target (°C)" Target="{Binding ElementName=HeaterTarget}"/>
                <TextBox x:Name="HeaterTarget" Width="75"/>
                <Button Content="_Apply heater target" Click="ApplyTarget" Margin="8,0"/>
                <Button x:Name="FeederToggle" Click="ToggleFeeder"/>
                <Button x:Name="HistoryButton" Content="View histor_y" Click="ShowHistory" Margin="8,0,0,0"/>
                <Button Content="_Back to mode selection" Click="BackToLogin" Margin="8,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="PumpToggle" Click="TogglePump"/>
                <Label Content="Pump _speed (%)" Target="{Binding ElementName=PumpSpeed}"/>
                <TextBox x:Name="PumpSpeed" Width="55"/>
                <Button x:Name="PumpApply" Content="Apply speed" Click="ApplyPumpSpeed" Margin="8,0"/>
                <Button x:Name="FilterToggle" Click="ToggleFilter"/>
                <Label Content="Aerator _output (%)" Target="{Binding ElementName=AeratorOutput}"/>
                <TextBox x:Name="AeratorOutput" Width="55"/>
                <Button x:Name="AeratorApply" Content="Apply output" Click="ApplyAeratorOutput" Margin="8,0"/>
            </WrapPanel>
            <TextBlock x:Name="CommandFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <GroupBox Header="Active alarms for selected habitat" DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ListBox x:Name="ActiveAlarms" MaxHeight="90" MinHeight="24"/>
        </GroupBox>
        <ListView x:Name="SensorReadings">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Habitat" DisplayMemberBinding="{Binding HabitatId}" Width="170"/>
                    <GridViewColumn Header="Sensor" DisplayMemberBinding="{Binding SensorName}" Width="230"/>
                    <GridViewColumn Header="Reading" DisplayMemberBinding="{Binding Reading}" Width="150"/>
                    <GridViewColumn Header="Unit" DisplayMemberBinding="{Binding Unit}" Width="90"/>
                    <GridViewColumn Header="Classification" DisplayMemberBinding="{Binding Classification}" Width="125"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
